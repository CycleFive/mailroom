// Copy to wrangler.jsonc (git-ignored) and fill in your own values:
//   cp wrangler.example.jsonc wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Required by the OAuth library for Client ID Metadata Documents (Claude's preferred
  // way to identify itself): the Worker fetches client-supplied https URLs.
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create OAUTH_KV, then paste the id here.
    {
      "binding": "OAUTH_KV",
      "id": "<your-kv-namespace-id>"
    }
  ],
  "services": [
    // The mailbox logic. It has no public URL; this binding is the only way in. It also does
    // each agent's Sign in with Discord through that agent's own broker.
    { "binding": "MAILROOM", "service": "mailroom-core" }
  ],
  "vars": {
    // Public origin of this Worker, no trailing slash. The MCP URL of an agent is PUBLIC_URL + "/<agent>/mcp".
    "PUBLIC_URL": "https://mailroom.<subdomain>.workers.dev",
    // Who may sign in: YOUR numeric Discord user ID (Developer Mode -> right-click yourself -> Copy User ID).
    "ALLOWED_DISCORD_USERS": "<your-discord-user-id>",
    // Optional: "true" makes Claude register via DCR instead of a Client ID Metadata Document.
    "DISABLE_CIMD": "",
    // Optional: Origins accepted when a request carries an Origin header.
    "ALLOWED_ORIGINS": ""
  },
  // This Worker holds no secrets: the Discord client secrets stay in the brokers.
  "observability": {
    "enabled": true
  }
}
